# ─── Infrastructure mode ─────────────────────────────────────────────
# embedded: no Docker. `pnpm infra` runs an embedded PostgreSQL in .data/pg,
#           object storage is the local disk (.data/storage), queues run on Postgres.
# docker:   `pnpm infra` runs `docker compose up` (postgres, redis, minio).
INFRA_MODE=embedded

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sammly:sammly@localhost:5433/sammly
# Only used by the embedded mode to boot the server:
EMBEDDED_PG_PORT=5433

# ─── Queue ───────────────────────────────────────────────────────────
# pg      → Postgres-backed queue (works with embedded mode, no Redis)
# bullmq  → BullMQ on Redis (docker mode / production)
QUEUE_DRIVER=pg
REDIS_URL=redis://localhost:6379

# ─── Object storage ──────────────────────────────────────────────────
# local → files under STORAGE_LOCAL_DIR
# s3    → any S3-compatible service (MinIO in docker mode, Cloudflare R2 in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=sammly
S3_ACCESS_KEY_ID=sammly
S3_SECRET_ACCESS_KEY=sammly-secret

# ─── Services ────────────────────────────────────────────────────────
API_PORT=4000
WORKER_HEALTH_PORT=4001
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# ─── Auth ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# ─── Render ──────────────────────────────────────────────────────────
RENDER_CONCURRENCY=2

# ─── AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
